; =============================================================================
; Arquivo: php.ini.dev
; Descrição: Configuração PHP para DESENVOLVIMENTO do StudyTrack Pro.
;            Diferente do php.ini (produção): validate_timestamps=1 para hot-reload.
; =============================================================================

[PHP]
memory_limit = 256M
upload_max_filesize = 20M
post_max_size = 20M
max_execution_time = 60
date.timezone = UTC

[opcache]
opcache.enable = 1
opcache.memory_consumption = 128
opcache.interned_strings_buffer = 16
opcache.max_accelerated_files = 20000
opcache.validate_timestamps = 1
opcache.save_comments = 1
opcache.jit = tracing
opcache.jit_buffer_size = 64M
