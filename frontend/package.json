{
  "name": "studytrack-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:analyze": "vue-tsc -b && vite build --config vite.config.analyze.ts",
    "preview": "vite preview",
    "test:run": "vitest run --config vitest.config.ts",
    "test": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,js,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,js,css,json}\""
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.5",
    "@primeuix/themes": "^2.0.3",
    "@tanstack/vue-query": "^5.101.2",
    "@tanstack/vue-virtual": "^3.13.31",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^14.3.0",
    "apexcharts": "^5.15.2",
    "axios": "^1.18.1",
    "fabric": "^7.4.0",
    "jspdf": "^4.2.1",
    "laravel-echo": "^2.3.7",
    "pinia": "^2.3.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "pusher-js": "^8.5.0",
    "v-viewer": "^3.0.23",
    "viewerjs": "^1.11.7",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4",
    "vue3-apexcharts": "^1.11.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/youtube": "^0.3.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^10.9.2",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.4.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.7"
  }
}
