{
  "name": "studytrack-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:analyze": "vue-tsc -b && vite build --config vite.config.analyze.ts",
    "preview": "vite preview",
    "test:run": "vitest run --config vitest.config.ts",
    "test": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,js,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,js,css,json}\""
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@primeuix/themes": "^2.0.3",
    "@sentry/vue": "^8.55.2",
    "@tanstack/vue-query": "^5.101.2",
    "@tanstack/vue-virtual": "^3.13.31",
    "@types/dompurify": "^3.0.5",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^14.3.0",
    "apexcharts": "^5.15.2",
    "axios": "^1.18.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.12",
    "fabric": "^7.4.0",
    "fengari-web": "^0.1.4",
    "jspdf": "^4.2.1",
    "laravel-echo": "^2.3.7",
    "pinia": "^3.0.4",
    "primeicons": "^8.0.0",
    "primevue": "^4.5.5",
    "pusher-js": "^8.5.0",
    "v-viewer": "^3.0.23",
    "viewerjs": "^1.11.7",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4",
    "vue3-apexcharts": "^1.11.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/youtube": "^0.3.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
