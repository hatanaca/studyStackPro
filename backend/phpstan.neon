includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon
parameters:
    level: 8
    paths:
        - app
    ignoreErrors:
        -
            identifier: method.notFound
            message: '#Call to an undefined method Laravel\\Socialite\\Contracts\\Provider::stateless\(\)#'
        -
            identifier: property.notFound
            message: '#Access to an undefined property Laravel\\Socialite\\Contracts\\User::\$#'
        -
            identifier: return.type
            message: '#returned type .* is not covariant#'
        -
            identifier: param.type
            message: '#parameter .* type is not contravariant#'
